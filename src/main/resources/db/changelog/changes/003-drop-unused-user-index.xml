<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-drop-ix-reservation-user" author="car-reservation">
        <comment>No query filters reservations by user (reservations are always read by id), so the
            index only costs write throughput on the hottest table. Applied changesets are never
            edited, hence a new changeset instead of changing 001.</comment>
        <dropIndex tableName="reservation" indexName="ix_reservation_user"/>
        <rollback>
            <createIndex tableName="reservation" indexName="ix_reservation_user">
                <column name="user_id"/>
            </createIndex>
        </rollback>
    </changeSet>
</databaseChangeLog>
